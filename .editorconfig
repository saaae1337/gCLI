# Общие правила оформления: чтобы gofmt, git и редактор говорили одно и то же.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Двойной пробел в конце строки — это перенос строки в Markdown, её режем.
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
